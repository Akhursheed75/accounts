# Backend-only settings, for running without Docker. The Docker stack takes its
# configuration from the .env at the repository root instead.
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://reconcilia:reconcilia@127.0.0.1:5432/reconcilia
SECRET_KEY=dev-secret-not-for-production
STORAGE_ROOT=./storage
CORS_ORIGINS=http://localhost:3000
OCR_DPI=300
OCR_LANGUAGES=spa+eng
