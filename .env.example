# ---------------------------------------------------------------------------
# Copy to .env and change every value marked CHANGE ME before going live.
# Nothing in this file belongs in version control once it holds real secrets.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
POSTGRES_USER=reconcilia
POSTGRES_PASSWORD=CHANGE_ME_long_random_database_password
POSTGRES_DB=reconcilia

# Application ---------------------------------------------------------------
# Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ENVIRONMENT=production

# Set COOKIE_SECURE=true as soon as the site is served over HTTPS. Session
# cookies will then never be sent over a plain connection.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# The address people will use in the browser.
CORS_ORIGINS=http://localhost

# Where the application's own nginx listens on the host.
#
# On its own, leave these alone: 0.0.0.0:80 serves the site directly.
#
# With something in front of it terminating TLS - Caddy from enable-https.sh, or
# your own nginx on 80/443 - point that front end at HTTP_PORT and set
# HTTP_BIND=127.0.0.1, so the application cannot also be reached unencrypted
# from the internet on this port.
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# Uploads and OCR -----------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
OCR_DPI=300
OCR_LANGUAGES=spa+eng

# Optional: read photos of the handwritten daily sheet into the form.
# Create a key at https://console.anthropic.com (about 1-2 US cents per sheet).
# Leave empty to keep photos with the sheet and type the amounts by hand.
ANTHROPIC_API_KEY=
SHEET_READER_MODEL=claude-sonnet-5-5

# Reconciliation defaults (also editable in the app, under Settings) ---------
DEFAULT_DATE_WINDOW_DAYS=3

# First administrator, created by the seed command --------------------------
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_NAME=System administrator
ADMIN_PASSWORD=CHANGE_ME_first_admin_password
